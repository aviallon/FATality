#!/usr/bin/env bash
# FATality pre-commit: ruff + mypy must be green (fast checks only).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

PY=.venv/bin
if [ ! -x "$PY/ruff" ]; then
    echo "pre-commit: .venv missing — run: nix develop -c uv pip install -e '.[dev]'" >&2
    exit 1
fi

echo "pre-commit: ruff"
"$PY/ruff" check src tests
echo "pre-commit: mypy"
"$PY/mypy"
echo "pre-commit: OK"
